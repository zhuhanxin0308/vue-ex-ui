{
  "name": "vue-ex-ui",
  "version": "3.0.1",
  "type": "module",
  "description": "Vue 3 cyberpunk-styled UI component library with TypeScript support",
  "files": [
    "dist"
  ],
  "main": "./dist/ex-ui.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/ex-ui.js",
        "require": "./dist/ex-ui.cjs"
      },
      "import": "./dist/es/index.js",
      "require": "./dist/ex-ui.cjs"
    },
    "./style.css": "./dist/ex-ui.css",
    "./base.css": "./dist/es/assets/style-base.css",
    "./font.css": "./dist/es/assets/style-font.css",
    "./resolver": {
      "import": {
        "types": "./dist/resolver/index.d.ts",
        "default": "./dist/resolver/index.js"
      },
      "require": {
        "types": "./dist/resolver/index.d.cts",
        "default": "./dist/resolver/index.cjs"
      }
    },
    "./es": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./es/components/*": {
      "types": "./dist/es/components/*/index.d.ts",
      "import": "./dist/es/components/*/index.js"
    },
    "./es/composables/*": {
      "types": "./dist/es/composables/*.d.ts",
      "import": "./dist/es/composables/*.js"
    },
    "./es/locale": {
      "types": "./dist/es/locale/index.d.ts",
      "import": "./dist/es/locale/index.js"
    },
    "./es/utils": {
      "types": "./dist/es/utils/index.d.ts",
      "import": "./dist/es/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:full && npm run build:es && npm run build:resolver",
    "build:full": "vite build",
    "build:es": "vite build --config vite.config.es.ts",
    "build:resolver": "vite build --config vite.config.resolver.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:release": "node --test --experimental-test-coverage --test-coverage-include=scripts/release-context.mjs --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=80 scripts/release-context.node-test.mjs",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.tests.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vite preview --config docs/.vitepress/preview.config.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify:release": "npm run test:release && npm run verify:version && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run verify:tree-shaking && npm run build && npm run verify:package && npm run docs:build && npm run test:browser && npm run audit:production",
    "prepublishOnly": "npm run verify:release",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "vue3",
    "typescript",
    "component-library",
    "cyberpunk",
    "ui-components"
  ],
  "author": "Ex UI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuhanxin0308/vue-ex-ui.git"
  },
  "homepage": "https://github.com/zhuhanxin0308/vue-ex-ui#readme",
  "bugs": {
    "url": "https://github.com/zhuhanxin0308/vue-ex-ui/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10.8.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "echarts": "^6.1.0",
    "jsbarcode": "^3.12.3",
    "lunar-javascript": "^1.7.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8"
  },
  "peerDependenciesMeta": {
    "vue-i18n": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "jsbarcode": {
      "optional": true
    },
    "lunar-javascript": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "dom-serializer": "^3.1.1",
    "htmlparser2": "^12.0.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "echarts": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "fast-check": "^4.9.0",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsbarcode": "^3.12.3",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "lunar-javascript": "^1.7.7",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "sass-embedded": "^1.102.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "^3.3.10"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    }
  },
  "sideEffects": [
    "**/*.css",
    "*.css"
  ]
}
